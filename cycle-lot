    p = sp.add_parser("veille", help="le timer : attentes GitHub, relances, alertes", parents=[commun])
    p.set_defaults(f=cmd_veille)

    a = ap.parse_args()
    try:
        a.f(a)
    except Refus as e:
        print(f"REFUS : {e}", file=sys.stderr)
        sys.exit(2)
    except RuntimeError as e:
        print(f"ERREUR (réseau, GitHub ou Trello) : {e}. Réessaie dans une minute ; rien n'a été changé si l'erreur "
              f"est arrivée avant le message de succès.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
