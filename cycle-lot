def units_actives(agent, prefixe):
    rc, out, err = lancer([SYSTEMCTL, "--user", "list-units", f"{agent}-*", "--state=active,activating",
                           "--no-legend", "--plain"], timeout=30)
    motif = re.compile(rf"^{agent}-{re.escape(prefixe)}([^0-9]|$)")
    return [l.split()[0] for l in out.splitlines() if l.strip() and motif.match(l.split()[0])]


def info_session(etat, agent):
    """Session de l'agent dans le fil du lot : None si le gateway ne répond pas, {} si elle n'existe pas encore,
    sinon {"id": sessionId, "actif": un tour tourne}."""
    rc, out, err = lancer([OPENCLAW, "gateway", "call", "sessions.list", "--json", "--params",
                           json.dumps({"agentId": agent, "limit": 100})], timeout=90, env=env_openclaw())
    d = json_dans(out)
    if rc != 0 or "sessions" not in d:
        return None
    cle = cle_session(etat, agent)
    for s in d["sessions"]:
        if s.get("key") == cle:
            return {"id": s.get("sessionId"), "actif": bool(s.get("hasActiveRun") or s.get("status") == "running")}
    return {}


def session_active(etat, agent):
    """True / False ; None si le gateway ne répond pas (on ne relance pas sur une inconnue)."""
    i = info_session(etat, agent)
    return None if i is None else bool(i.get("actif"))


def remettre_a_zero(etat, agent):
    """Contexte neuf pour l'étape : sessions.reset de la session de l'agent dans le fil du lot, avec le sessionId lu juste
    avant (le gateway refuse si la session a changé entre-temps). Le routage vers le fil est conservé : la réponse au
    réveil y est postée. Rendu : « faite », « absente » (pas encore de
    session, donc déjà neuve), « occupee » (un tour tourne : ne pas l'interrompre), « inconnu » ou « echec » (réveil
    sans remise à zéro, comme avant)."""
    info = info_session(etat, agent)
    if info is None:
        res = "inconnu"
    elif not info:
        res = "absente"
    elif info["actif"]:
        res = "occupee"
    else:
        params = {"key": cle_session(etat, agent), "agentId": agent, "reason": "reset"}
        if info.get("id"):
            params["expectedSessionId"] = info["id"]
        rc, out, err = lancer([OPENCLAW, "gateway", "call", "sessions.reset", "--json", "--params", json.dumps(params)],
                              timeout=120, env=env_openclaw())
        res = "faite" if rc == 0 and json_dans(out).get("ok") else "echec"
        if res == "echec":
            journal(etat["version"], f"remise à zéro de la session de {agent} : ÉCHEC {(err or out).strip()[-200:]}")
    journal(etat["version"], f"contexte de {agent} pour l'étape « {etat['etape']} » : {res}")
    return res


def veiller_tour(etat):
    """Un agent a la main : rien à faire tant qu'un job `<agent>-<prefixe>-*` tourne ou que l'étape est récente.
    Le CLI openclaw coûte ~20 s de CPU : on ne lit l'état de la session qu'après INACTIF_MIN sans signe de vie,
    et pas plus d'une fois toutes les 10 min."""
    agent, r = etat["tour"], etat["relances"]
    units = units_actives(agent, etat["prefixe"])
    plafond = ETAPES[etat["etape"]][1]

    def plafond_depasse(quoi):
        if plafond and minutes_depuis(etat["depuis"]) > plafond * 60 and not r.get("alerte_plafond"):
            r["alerte_plafond"] = True
            planifier_avis(etat, f"l'étape « {etat['etape']} » dure depuis {hm(etat['depuis'])}, au-delà de son plafond "
                                 f"de {plafond} h, alors que {agent} travaille encore ({quoi}). Rien n'est bloqué côté "
                                 f"relais ; à regarder si ça te semble anormal.")
    if units:
        r["vu_actif"] = iso()
        plafond_depasse(", ".join(units))
        return
    reperes = [date(etat["depuis"])] + [date(x) for x in (r.get("vu_actif"), r.get("derniere")) if x]
    inactif = (maintenant() - max(reperes)).total_seconds() / 60
    if inactif < INACTIF_MIN:
        return
    if r.get("verif_session") and minutes_depuis(r["verif_session"]) < 10:
        return
    r["verif_session"] = iso()
    actif = session_active(etat, agent)
    if actif is None:
        return
    if actif:
        r["vu_actif"] = iso()
        plafond_depasse("tour en cours")
        return
    if r.get("nb", 0) < NB_RELANCES:
        r["nb"] = r.get("nb", 0) + 1
        r["derniere"] = iso()
        prefixe = (f"Relance automatique n°{r['nb']} : depuis {int(inactif)} min, ni changement d'étape, ni tour en "
                   f"cours, ni job `{agent}-{etat['prefixe']}-…` actif. Si l'étape est finie, termine-la par sa "
                   f"commande ; si un job tourne sous un autre nom, dis-le en une ligne.\n")
        planifier_reveil(etat, agent, f"relance {r['nb']}", prefixe=prefixe)
    elif not r.get("alerte"):
        r["alerte"] = True
        planifier_avis(etat, f"{agent} ne répond pas sur l'étape « {etat['etape']} » (main depuis {hm(etat['depuis'])}, "
                             f"{NB_RELANCES} relances sans effet). <@{HUMAIN_SLACK}> une relance de ta part dans ce fil est "
                             f"nécessaire.")


def url_run(depot, run_id):
    return f"https://github.com/{DEPOTS[depot]}/actions/runs/{run_id}" if run_id else None


def veiller_runs(etat, cibles, requis_par_cible):
    """cibles : [(depot, sha, event, branche)] -> ('attente' | 'vert' | 'rouge', lignes de bilan, {(depot, sha): résumé}).
    Le dernier état lu de chaque run reste dans attente.suivi : le monitor (vue Graph) l'affiche sous le lot."""
    att = etat["attente"]
    lignes, en_cours, rouges, par_cible = [], False, False, {}
    suivi = []
    for (depot, sha, event, branche), requis in zip(cibles, requis_par_cible):
        run = dernier_run(depot, sha, event, branche)
        verdict, resume = bilan_run(depot, run, requis)
        rid = run["databaseId"] if run else None
        suivi.append({"depot": depot, "branche": branche, "sha": sha, "event": event, "run": rid,
                      "url": url_run(depot, rid), "verdict": verdict, "resume": resume,
                      "debut": run.get("createdAt") if run else None})
        if verdict in ("absent", "en cours"):
            en_cours = True
        elif verdict == "rouge":
            if relancer_si_sans_rapport(etat, depot, run, att.setdefault("relances", [])):
                en_cours = True
                resume += " (relancé une fois : sans rapport avec le code)"
                suivi[-1]["verdict"] = "en cours"
            else:
                rouges = True
        par_cible[(depot, sha)] = resume
        suivi[-1]["resume"] = resume
        lignes.append(f"{depot}{' ' + branche if branche else ''} `{sha[:7]}` : {verdict}, {resume}")
    att["suivi"] = suivi
    att["suivi_heure"] = iso()
    return ("attente" if en_cours else "rouge" if rouges else "vert"), lignes, par_cible


def veiller_attente(etat):
    e, att = etat["etape"], etat["attente"] or {}
    duree = minutes_depuis(etat["depuis"])
    plafond = (ETAPES[e][1] or 3) * 60
    if e == "deploiement-revue":
        dep = att.get("deploiement") or {}
        note = None
        if dep.get("erreur"):
            note = f"Déploiement du back du lot sur la preview impossible ({dep['erreur'][:200]})."
        else:
            if not dep.get("run"):
                dep["run"] = trouver_run_dispatch(dep["branche"], date(dep["lance"]) - dt.timedelta(minutes=1))
            if dep.get("run"):
                depot = PREVIEW["depot"]
                run = next((r for r in runs(depot, branch=dep["branche"], event="workflow_dispatch")
                            if r["databaseId"] == dep["run"]), None)
                verdict, resume = bilan_run(depot, run, tuple(PREVIEW.get("jobs_requis") or REQUIS_PUSH))
                dep.update(verdict=verdict, resume=resume, url=url_run(depot, dep["run"]), vu=iso())
                if verdict == "vert":
                    dep["vert_a"] = dep.get("vert_a") or iso()
                    if minutes_depuis(dep["vert_a"]) < ATTENTE_PREVIEW_MIN:
                        return
                elif verdict == "rouge":
                    if relancer_si_sans_rapport(etat, depot, run, dep.setdefault("relances", [])):
                        return
                    note = (f"Le déploiement du back du lot sur la preview a échoué ({resume}). Si c'est le code du "
                            f"lot, c'est un point bloquant ; sinon fais la revue sans le back du lot en preview et dis-le.")
                elif duree < plafond:
                    return
                else:
                    note = f"Déploiement du back du lot toujours en cours après {int(duree)} min ({resume})."
            elif duree < 20:
                return
            else:
                note = "Aucun run de déploiement trouvé pour la branche du lot."
        changer_etape(etat, "revue", "veille")
        etat["attente"] = {"deploiement": dep}
        planifier_reveil(etat, REV, "revue", extra=extra_revue(etat, note))
    elif e == "ci-release":
        cibles = [(d, tete(d, etat["release"]), "push", etat["release"]) for d in att["depots"]]
        verdict, lignes, _ = veiller_runs(etat, cibles, [REQUIS_PUSH] * len(cibles))
        if verdict == "attente" and duree < plafond:
            return
        if verdict == "vert":
            etat["ci_rouges"] = 0
            note = ""
            if not [i for i in etat["interventions"] if not i["faite"]]:
                try:  # le relais ouvre lui-même les PR de livraison : pas de tour d'agent pour un geste mécanique
                    prs, _ = ouvrir_prs_livraison(etat)
                    changer_etape(etat, "ci-livraison", "veille", "CI du push sur la release verte, PR de livraison ouvertes "
                                  "par le relais :\n" + "\n".join(lignes), attente={"debut": iso(), "relances": []})
                    planifier_avis(etat, "CI de la release verte. PR de livraison ouvertes : " + ", ".join(
                        f"{p['depot']}#{p['num']} vers {p['base']}" for p in prs) + ". J'attends leur CI, je contrôle "
                        f"qu'elles n'apportent que le lot revu, puis je les merge ; je ne réveille {N_REV} qu'en cas d'écart.")
                    return
                except (Refus, RuntimeError) as e:
                    note = f"\nOuverture automatique des PR de livraison impossible : {e}"
            changer_etape(etat, "livraison", "veille", "CI du push sur la release verte :\n" + "\n".join(lignes) + note)
            planifier_reveil(etat, DEV, "livraison")
        elif verdict == "rouge":
            etat["ci_rouges"] += 1
            if etat["ci_rouges"] >= MAX_CI_ROUGES:
                arreter(etat, "veille", "ci", f"CI du push sur {etat['release']} rouge {etat['ci_rouges']} fois de suite : "
                        + " ; ".join(lignes))
            else:
                changer_etape(etat, "correction", "veille", f"CI du push sur {etat['release']} rouge après le merge du lot. "
                              f"Corrige par une PR vers {etat['release']}, puis `cycle-lot passe {etat['version']} "
                              f"--vers {REV}`.\n" + "\n".join(lignes))
                planifier_reveil(etat, DEV, "correction")
        else:
            arreter(etat, "veille", "ci", f"CI du push sur {etat['release']} sans verdict après {int(duree)} min : "
                    + " ; ".join(lignes))
    elif e == "ci-livraison":
        master = [x for x in etat["prs_livraison"] if x["base"] == "master"]
        cibles = [(x["depot"], x["sha"], "pull_request", None) for x in master]
        verdict, lignes, par_cible = veiller_runs(etat, cibles, [REQUIS_MASTER[x["depot"]] for x in master])
        if verdict == "attente" and duree < plafond:
            return
        for x in etat["prs_livraison"]:
            x["ci"] = par_cible.get((x["depot"], x["sha"]), "?") if x["base"] == "master" else "pas de CI de PR vers develop"
        note = "" if verdict != "attente" else f"\nCI encore incomplète après {int(duree)} min."
        if verdict == "vert":  # contenu = lot revu et CI verte : le relais merge, sans tour du relecteur
            try:
                ok, detail = controle_livraison(etat)
                if ok:
                    for x in sorted(etat["prs_livraison"], key=lambda x: (x["depot"] != "back", x["base"])):
                        merger_pr(etat, etat["prs_livraison"], x["depot"], x["num"], "veille")
                    apres_merges(etat, "veille")
                    planifier_avis(etat, "PR de livraison mergées (CI verte, contenu = lot revu) : " + ", ".join(
                        f"{x['depot']}#{x['num']} vers {x['base']}" for x in etat["prs_livraison"])
                        + f". J'attends la CI de develop et de master, puis {N_DEV} prépare les validations en production.")
                    return
                note = "\n" + detail
            except (Refus, RuntimeError) as e:
                note = f"\nMerge automatique des PR de livraison interrompu : {e}"
        changer_etape(etat, "revue-livraison", "veille", "CI des PR de livraison :\n" + "\n".join(lignes) + note)
        planifier_reveil(etat, REV, "revue-livraison")
    elif e == "deploiement":
        cibles = [(c["depot"], c["commit"], "push", c["base"]) for c in att["commits"]]
        verdict, lignes, _ = veiller_runs(etat, cibles, [REQUIS_PUSH] * len(cibles))
        if verdict == "attente" and duree < plafond:
            return
        if verdict == "vert":
            changer_etape(etat, "liste-validation", "veille", "CI de develop et de master verte, lot en production :\n"
                          + "\n".join(lignes))
            planifier_reveil(etat, DEV, "liste-validation")
        else:
            arreter(etat, "veille", "deploiement",
                    ("CI de livraison rouge" if verdict == "rouge" else f"CI de livraison sans verdict après "
                     f"{int(duree)} min") + " : " + " ; ".join(lignes) + f". {N_DEV} est réveillé pour le diagnostic.",
                    etape_reprise="liste-validation")
            planifier_reveil(etat, DEV, "diagnostic", texte=(
                f"[RELAIS DU CYCLE DE LOT {etat['version']} — message automatique de cycle-lot, pas de {HUMAIN}] La mise "
                f"en production du lot est en échec :\n" + "\n".join(lignes) +
                f"\nLe cycle est arrêté pour {HUMAIN}. Diagnostique (code, serveur, Sonar, réseau) et poste dans ce fil ce que "
                "tu proposes ; ne corrige rien sans sa réponse. Réponse obligatoire, NO_REPLY interdit."))


def veiller_lot(etat):
    executer_en_attente(etat)
    if etat.get("a_reveiller") or etat["etape"] == "arret":
        return
    if etat["tour"] == "veille":
        att = etat.get("attente") or {}
        if att.get("verifie") and minutes_depuis(att["verifie"]) < INTERVALLE_GH_MIN:
            return
        att["verifie"] = iso()
        etat["attente"] = att
        veiller_attente(etat)
    elif etat["tour"] in (DEV, REV):
        veiller_tour(etat)
    executer_en_attente(etat)


def veiller_programmations():
    p = CYCLES / "programmations.json"
    if not p.exists():
        return
    progs = json.loads(p.read_text())
    change = False
    for prog in progs:
        if prog.get("fait"):
            continue
        try:
            avant = lire(prog["apres"])
        except Refus:
            continue
        if avant["etape"] in ("liste-validation", "validation-prod", "livre"):
            m = RE_SESSION.match(prog["cle"])
            faux = {"version": prog["version"], "prefixe": prog["version"].replace(".", ""), "seq": 0, "reveils": [],
                    "n_reveil": int(time.time()),
                    "fil": {"canal": m.group("canal").upper(), "ts": m.group("ts")}}
            texte = (f"[RELAIS — lancement différé demandé par {HUMAIN}] Le lot {prog['apres']} est mergé sur develop et "
                     f"master et en production. {HUMAIN} t'a demandé d'attaquer ensuite le lot {prog['version']} : "
                     f"lance-le maintenant (`cycle-lot debut {prog['version']} --session-key {prog['cle']}`, branches "
                     f"release/{prog['version']} tirées de develop). Réponse obligatoire dans ce fil.")
            if reveiller(faux, DEV, texte, "lancement différé"):
                prog["fait"] = iso()
                change = True
    if change:
        p.write_text(json.dumps(progs, ensure_ascii=False, indent=2))


def cmd_veille(a):
    t0, lots, erreurs = time.monotonic(), [], []
    chemins = sorted(CYCLES.glob("*/etat.json"))
    tableau = lire_tableau_pour_avancement(chemins)  # cartes Trello des lots en cours, pour le monitor
    for p in chemins:
        v = p.parent.name
        try:
            with verrou(v):
                etat = lire(v)
                if etat["etape"] == "livre":
                    continue
                lots.append(v)
                veiller_lot(etat)
                noter_avancement(etat, tableau)
                ecrire(etat)
        except Exception as e:  # noqa: BLE001 — un lot en erreur ne bloque pas les autres
            print(f"{v} : {type(e).__name__} : {e}", file=sys.stderr)
            erreurs.append(f"{v} : {type(e).__name__} : {str(e)[:300]}")
            try:
                journal(v, f"veille : erreur {type(e).__name__} : {str(e)[:300]}")
            except OSError:
                pass
    try:
        veiller_programmations()
    except Exception as e:  # noqa: BLE001
        print(f"programmations : {e}", file=sys.stderr)
        erreurs.append(f"programmations : {str(e)[:300]}")
    # pouls du relais, lu par le monitor (vue Graph) : un passage daté, sa durée et ses erreurs
    CYCLES.mkdir(parents=True, exist_ok=True)
    pouls = CYCLES / ".veille.json"
    tmp = pouls.with_suffix(".tmp")
    tmp.write_text(json.dumps({"derniere": iso(), "duree_s": round(time.monotonic() - t0, 1), "lots": lots,
                               "erreurs": erreurs}, ensure_ascii=False))
    os.replace(tmp, pouls)


