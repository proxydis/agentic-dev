def ligne_pr(p):
    s = f"• {p['depot']} #{p['num']} ({p.get('base') or p.get('branche')}) {p['url']}, tête `{p['sha'][:7]}`"
    if p.get("ci"):
        s += f", CI : {p['ci']}"
    if p.get("merge"):
        s += f", mergée en `{p['merge']['commit'][:7]}`"
    return s


def pied(etat, agent=None):
    return (f"\n\nÉtat complet : `cycle-lot etat {etat['version']}`. Procédure : {DOC_PROCEDURE}. "
            f"Réponse obligatoire dans ce fil, NO_REPLY interdit : dis en une ou deux phrases ce que tu lances. "
            f"Ne mentionne pas l'autre agent avec <@…> : le relais le réveillera. Tout travail de plus de 30 min tourne "
            f"dans une unit `{agent or etat['tour']}-{etat['prefixe']}-…` dont la fin te réveille ; n'écris aucun script "
            f"qui attende l'autre agent ou la CI, c'est le relais qui attend.")


def diff_depuis_revue(pr, rapport):
    """Ligne de consigne : ce que la reprise a changé sur une PR depuis la tête revue."""
    cle = f"{pr['depot']}#{pr['num']}"
    avant = (rapport.get("tetes") or {}).get(cle)
    if not avant:
        return f"• {cle} : tête revue inconnue, relis le diff de la reprise (`git log` de la branche depuis ta revue)"
    if avant == pr["sha"]:
        return f"• {cle} : inchangée depuis ta revue (`{avant[:7]}`), rien à relire"
    detail = ""
    try:
        cmp = gh_json("api", f"repos/{DEPOTS[pr['depot']]}/compare/{avant}...{pr['sha']}", essais=2)
        fichiers = cmp.get("files") or []
        detail = (f" : {len(cmp.get('commits') or [])} commit(s), {len(fichiers)} fichier(s), "
                  f"+{sum(f.get('additions', 0) for f in fichiers)} −{sum(f.get('deletions', 0) for f in fichiers)}")
    except (RuntimeError, AttributeError):
        pass
    return f"• {cle} : `git diff {avant[:12]}..{pr['sha'][:12]}`{detail}"


