    p = sp.add_parser("fin", help=f"{N_REV} : lot validé en production", parents=[commun])
    p.add_argument("version")
    p.add_argument("--rapport", required=True)
    p.set_defaults(f=cmd_fin)

    p = sp.add_parser("programmer", help=f"{N_DEV}, sur demande explicite de {HUMAIN} : lancer Y quand X est livré",
                      parents=[commun])
    p.add_argument("version")
    p.add_argument("--apres", required=True)
