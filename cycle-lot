class Refus(Exception):
    """Commande refusée : le message dit à l'agent quoi faire. Code de sortie 2."""


# ---------------------------------------------------------------- utilitaires

def maintenant():
    return dt.datetime.now().astimezone()


def iso(t=None):
    return (t or maintenant()).isoformat(timespec="seconds")


def date(s):
    return dt.datetime.fromisoformat(s)


def minutes_depuis(s):
    return (maintenant() - date(s)).total_seconds() / 60


def hm(s):
    return date(s).astimezone().strftime("%d/%m %H:%M")


def env_openclaw():
    env = dict(os.environ)
    env["PATH"] = os.path.dirname(OPENCLAW) + ":" + env.get("PATH", "/usr/bin:/bin")
    return env


def lancer(cmd, timeout=180, env=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"délai dépassé ({timeout} s) : {' '.join(cmd[:4])}"
    except OSError as e:
        return 127, "", str(e)


def json_dans(texte):
    i = texte.find("{")
    try:
        return json.loads(texte[i:]) if i >= 0 else {}
    except ValueError:
        return {}


def gh_json(*args, timeout=120, essais=3):
    """`gh … --json`, réessayé : un réseau instable coupe parfois un appel."""
    dernier = ""
    for i in range(essais):
        rc, out, err = lancer([GH, *args], timeout=timeout)
        if rc == 0:
            try:
                return json.loads(out or "null")
            except ValueError:
                dernier = out[-300:]
        else:
            dernier = (err or out)[-300:]
        if i < essais - 1:
            time.sleep(3 * (i + 1))
    raise RuntimeError(f"gh {' '.join(args[:3])} : {dernier.strip()}")


def gh_cmd(*args, timeout=180):
    rc, out, err = lancer([GH, *args], timeout=timeout)
    return rc, (out + err).strip()


# ---------------------------------------------------------------- état

def dossier(version):
    return CYCLES / version


def chemin_etat(version):
    return dossier(version) / "etat.json"


def lire(version):
    p = chemin_etat(version)
    if not p.exists():
        raise Refus(f"aucun cycle pour le lot {version} : il commence par `cycle-lot debut {version} …`, "
                    f"lancé par {N_DEV} sur demande de {HUMAIN}")
    return json.loads(p.read_text())


def ecrire(etat):
    p = chemin_etat(etat["version"])
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(etat, ensure_ascii=False, indent=2))
    os.replace(tmp, p)


@contextmanager
def verrou(version, creer=False):
    """Verrou d'un lot. Seul `debut` crée le dossier : une commande refusée ne laisse pas de cycle vide derrière elle."""
    if not RE_VERSION.match(version):
        raise Refus(f"version « {version} » illisible (ex. 1.0.0 ou 1.2.3.4)")
    if not creer:
        lire(version)
    dossier(version).mkdir(parents=True, exist_ok=True)
    with open(dossier(version) / ".verrou", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def journal(version, texte):
    dossier(version).mkdir(parents=True, exist_ok=True)
    with open(dossier(version) / "journal.log", "a") as f:
        f.write(f"{iso()} {texte}\n")


def changer_etape(etat, etape, par, message="", attente=None):
    tour = ETAPES[etape][0]
    etat["historique"].append({"heure": iso(), "de": etat.get("etape"), "vers": etape, "par": par,
                               "message": (message or "")[:3000]})
    etat.update(etape=etape, tour=tour, depuis=iso(), seq=etat["seq"] + 1, attente=attente)
    etat["relances"] = {"nb": 0, "derniere": None, "alerte": False, "alerte_plafond": False, "vu_actif": None}
    if message:
        etat["dernier_message"] = {"de": par, "heure": iso(), "texte": message[:3000]}
    journal(etat["version"], f"étape {etape} (main : {tour}) par {par}" + (f" : {message[:300]}" if message else ""))


def appelant(args):
    if getattr(args, "par", None):
        return args.par
    cwd = os.getcwd()
    for agent in (DEV, REV, RELAIS):
        if f"/workspace-{agent}" in cwd:
            return agent
    raise Refus(f"agent appelant inconnu : ajoute --par {DEV} ou --par {REV}")


def exiger(etat, agent, etapes):
    if etat["etape"] not in etapes:
        raise Refus(f"le lot {etat['version']} est à l'étape « {etat['etape']} » (main : {etat['tour']}) ; "
                    f"cette commande vaut pour : {', '.join(etapes)}. `cycle-lot etat {etat['version']}` pour le détail.")
    if agent != RELAIS and etat["tour"] not in (agent, "veille"):
        raise Refus(f"la main est à {etat['tour']} sur l'étape « {etat['etape']} », pas à {agent}")


def num_pr(texte):
    m = re.fullmatch(r"(back|front)#?(\d+)", texte.strip())
    if not m:
        raise Refus(f"PR « {texte} » : écris back#277 ou front#296")
    return m.group(1), int(m.group(2))


def liste_nums(texte):
    if not texte:
        return set()
    try:
        return {int(x) for x in re.split(r"[,\s]+", texte.strip()) if x}
    except ValueError:
        raise Refus(f"numéros de cartes illisibles : « {texte} » (ex. 1,3,5)")


# ---------------------------------------------------------------- Slack : réveil et avis

def cle_session(etat, agent):
    return f"agent:{agent}:slack:channel:{etat['fil']['canal'].lower()}:thread:{etat['fil']['ts']}"


def planifier_reveil(etat, agent, motif, texte=None, extra="", prefixe=""):
    """Les commandes des agents ne réveillent personne elles-mêmes : le gateway refuse, depuis l'exec d'un agent,
    un tour lancé dans une autre session (« would lose inter-session attribution »). C'est le service du relais
    (systemd, toutes les 2 min, hors de l'exec d'un agent) qui réveille, à partir de l'état. La consigne est écrite
    au moment du réveil, sur l'état à jour."""
    etat["a_reveiller"] = {"agent": agent, "motif": motif, "texte": texte, "extra": extra, "prefixe": prefixe,
                           "seq": etat["seq"], "demande": iso(), "essais": 0, "signale": False,
                           "contexte_neuf": CONTEXTE_NEUF and motif in MOTIFS_ETAPE, "contexte": None}


def planifier_avis(etat, texte):
    etat.setdefault("avis_en_attente", []).append({"texte": texte, "essais": 0})


def executer_en_attente(etat):
    """Service du relais seulement : avis à poster, puis réveil planifié (4 essais, puis avis à l'humain)."""
    restants = []
    for avis in etat.pop("avis_en_attente", None) or []:
        if not poster(etat, avis["texte"]) and avis["essais"] < 3:
            restants.append({"texte": avis["texte"], "essais": avis["essais"] + 1})
    if restants:
        etat["avis_en_attente"] = restants
    r = etat.get("a_reveiller")
    if not r:
        return
    if r["seq"] != etat["seq"]:
        journal(etat["version"], f"réveil de {r['agent']} ({r['motif']}) abandonné : l'étape a changé depuis")
        etat["a_reveiller"] = None
        return
    if r["essais"] >= 4:
        if not r["signale"]:
            r["signale"] = True
            poster(etat, f"impossible de réveiller {NOMS.get(r['agent'], r['agent'])} pour l'étape « {etat['etape']} » "
                         f"({r['essais']} essais). <@{HUMAIN_SLACK}> le gateway a peut-être un problème ; une mention de "
                         f"l'agent dans ce fil le relance.")
        return
    if r.get("contexte_neuf") and not r.get("contexte"):
        res = remettre_a_zero(etat, r["agent"])
        if res == "occupee" and minutes_depuis(r["demande"]) < ATTENTE_TOUR_MIN:
            return  # un tour de l'agent tourne dans cette session : le relais repasse dans 2 min
        r["contexte"] = res
    neuf = (f"\nContexte neuf : ta session a été remise à zéro pour cette étape, l'historique du fil n'y est plus. Tout ce "
            f"qu'il te faut est dans ce message, dans `cycle-lot etat {etat['version']}`, le dossier du lot et les rapports."
            if r.get("contexte") == "faite" else "")
    r["essais"] += 1
    texte = (r["texte"] + neuf) if r["texte"] else (r.get("prefixe") or "") + consigne(etat, (r.get("extra") or "") + neuf,
                                                                                        agent=r["agent"])
    if reveiller(etat, r["agent"], texte, r["motif"] + (f" (essai {r['essais']})" if r["essais"] > 1 else "")):
        etat["a_reveiller"] = None


def reveiller(etat, agent, texte, motif):
    """Lance un tour de l'agent dans SA session du fil du lot ; sa réponse y est postée. Routage explicite :
    la session du relecteur n'existe pas encore quand le relais le réveille la première fois dans un fil neuf.
    Appelé par le service du relais seulement (voir planifier_reveil)."""
    n = etat.get("n_reveil", 0) + 1
    etat["n_reveil"] = n
    params = {"sessionKey": cle_session(etat, agent), "message": texte, "deliver": True, "channel": "slack",
              "accountId": agent, "to": f"channel:{etat['fil']['canal']}", "threadId": etat["fil"]["ts"],
              "idempotencyKey": f"relais-{etat['prefixe']}-{etat['seq']}-{agent}-{n}"}
    rc, out, err = lancer([OPENCLAW, "gateway", "call", "agent", "--json", "--timeout", "90000",
                           "--params", json.dumps(params, ensure_ascii=False)], timeout=150, env=env_openclaw())
    rep = json_dans(out)
    ok = rep.get("status") in ("accepted", "ok", "in_flight")
    etat["reveils"].append({"n": n, "heure": iso(), "agent": agent, "motif": motif, "seq": etat["seq"], "ok": ok,
                            "runId": rep.get("runId"), "erreur": None if ok else (err or out).strip()[-300:]})
    del etat["reveils"][:-50]
    journal(etat["version"], f"réveil de {agent} ({motif}) : {'accepté, run ' + str(rep.get('runId')) if ok else 'ÉCHEC ' + (err or out).strip()[-200:]}")
    return ok


def slack_direct(compte, canal, ts, texte):
    """Dernier filet quand le gateway ne répond pas : API Slack avec le jeton du compte, lu dans la config OpenClaw."""
    try:
        tok = json.loads(CONFIG.read_text())["channels"]["slack"]["accounts"][compte].get("botToken")
        if not isinstance(tok, str):
            return False
        req = urllib.request.Request("https://slack.com/api/chat.postMessage",
                                     data=json.dumps({"channel": canal, "thread_ts": ts, "text": texte}).encode(),
                                     headers={"Authorization": "Bearer " + tok,
                                              "Content-Type": "application/json; charset=utf-8"})
        return bool(json.load(urllib.request.urlopen(req, timeout=20)).get("ok"))
    except Exception:  # noqa: BLE001 — filet de secours, ne doit jamais lever
        return False


def poster(etat, texte):
    """Avis du relais dans le fil du lot, au nom du compte du relais : jamais une mention d'agent."""
    texte = f"⚙️ Relais du lot {etat['version']} : {texte}"
    rc, out, err = lancer([OPENCLAW, "message", "send", "--channel", "slack", "--account", RELAIS,
                           "--target", f"channel:{etat['fil']['canal']}", "--thread-id", etat["fil"]["ts"],
                           "--message", texte, "--json"], timeout=120, env=env_openclaw())
    ok = rc == 0 or slack_direct(RELAIS, etat["fil"]["canal"], etat["fil"]["ts"], texte)
    journal(etat["version"], f"avis posté ({'ok' if ok else 'ÉCHEC'}) : {texte[:200]}")
    return ok


# ---------------------------------------------------------------- Trello

def trello_cles():
    k, t = os.environ.get("TRELLO_API_KEY"), os.environ.get("TRELLO_TOKEN")
    if k and t:
        return k, t
    try:
        env = json.loads(CONFIG.read_text())["skills"]["entries"]["trello"]["env"]
        return env["TRELLO_API_KEY"], env["TRELLO_TOKEN"]
    except Exception:  # noqa: BLE001
        raise RuntimeError("clés Trello introuvables (TRELLO_API_KEY / TRELLO_TOKEN)")


def trello(methode, chemin, _essais=3, _delai=30, **params):
    k, t = trello_cles()
    auth = urllib.parse.urlencode({"key": k, "token": t})
    corps = None
    if methode == "POST":  # description longue : dans le corps
        url = f"{TRELLO_API}{chemin}?{auth}"
        corps = urllib.parse.urlencode(params).encode()
    else:  # GET, PUT : paramètres dans l'URL, comme run-lot.sh
        url = f"{TRELLO_API}{chemin}?{urllib.parse.urlencode(params)}&{auth}"
    dernier = None
    for i in range(_essais):
        try:
            req = urllib.request.Request(url, data=corps, method=methode)
            with urllib.request.urlopen(req, timeout=_delai) as r:
                texte = r.read().decode()
                return json.loads(texte) if texte else {}
        except Exception as e:  # noqa: BLE001
            dernier = e
            if i < _essais - 1:
                time.sleep(3 * (i + 1))
    raise RuntimeError(f"Trello {methode} {chemin} : {dernier}")


def cartes_du_tableau():
    return trello("GET", f"/boards/{TRELLO_BOARD}/cards/open", fields="name,idList,shortUrl")


def cartes_de_version(version, toutes=None):
    res = []
    for c in toutes if toutes is not None else cartes_du_tableau():
        m = RE_CARTE.match(c["name"])
        if m and m.group("ver") == version and c["idList"] not in (LISTES["canceled"], LISTES["archived"]):
            res.append({"id": c["id"], "num": int(m.group("num")), "nom": c["name"], "liste": c["idList"],
                        "url": c.get("shortUrl")})
    return sorted(res, key=lambda c: c["num"])


# Cartes du lot : `debut` en prend la liste, mais une carte peut être reportée ensuite (renommée [V<version suivante>-…]
# et remise en Not Ready). Restée dans le lot, le verdict À MERGER l'aurait passée en Finished. Jusqu'au verdict À MERGER,
# chaque lecture du tableau (relais, passe, verdict) aligne donc la liste sur les titres : une carte renommée vers une
# autre version sort du lot, et y revient si on lui rend la version du lot.
ETAPES_CARTES_SUIVIES = ("dev", "deploiement-revue", "revue", "correction")
# Verdict À MERGER : seules les cartes en cours de lot passent en Finished. Une carte en Not Ready, Standby, Blocked,
# Canceled ou Archived n'a pas été revue : elle reste où elle est, signalée.
LISTES_EN_COURS = ("wip", "waiting", "review")


def titre_court(nom):
    """« [V1.0.1-Back/Front] 6 » : version, type et numéro d'un titre de carte, sans le libellé."""
    m = RE_CARTE.match(nom or "")
    return f"[V{m.group('ver')}-{m.group('type')}] {m.group('num')}" if m else (nom or "")[:60]


def suivre_cartes(etat, toutes):
    """Aligne etat["cartes"] sur les titres du tableau (toutes : cartes ouvertes, avec name et idList), jusqu'au verdict
    À MERGER. Une carte fermée sur Trello reste (hors du total de l'avancement). Journalise et rend les changements ;
    l'appelant écrit l'état."""
    etape = etat["etape"] if etat["etape"] != "arret" else (etat.get("arret") or {}).get("etape")
    if etape not in ETAPES_CARTES_SUIVIES:
        return []
    v, par_id, changements = etat["version"], {c["id"]: c for c in toutes}, []
    gardees, sorties = [], etat.setdefault("cartes_sorties", [])
    for c in etat["cartes"]:
        t = par_id.get(c["id"])
        m = RE_CARTE.match(t.get("name") or "") if t else None
        if t is None or (m and m.group("ver") == v):
            gardees.append(c)
            continue
        liste = NOM_LISTE.get(LISTE_DE_ID.get(t.get("idList")), "?")
        sorties.append({**c, "nouveau_nom": t.get("name"), "version": m.group("ver") if m else None, "heure": iso()})
        changements.append(f"carte {c['num']} sortie du lot : renommée {titre_court(t.get('name'))}, en {liste}")
    pris = {c["num"] for c in gardees}
    for s in {s["id"]: s for s in sorties}.values():  # rendue à la version du lot : elle revient
        t = par_id.get(s["id"])
        m = RE_CARTE.match(t.get("name") or "") if t else None
        if not m or m.group("ver") != v or s["id"] in {c["id"] for c in gardees}:
            continue
        if int(m.group("num")) in pris:
            continue  # numéro repris entre-temps : elle reste hors du lot plutôt que de créer un doublon
        gardees.append({"id": s["id"], "num": int(m.group("num")), "nom": t["name"], "url": s.get("url")})
        pris.add(int(m.group("num")))
        changements.append(f"carte {m.group('num')} revenue dans le lot : {titre_court(t['name'])}")
    if changements:
        etat["cartes"] = sorted(gardees, key=lambda c: c["num"])
        for x in changements:
            journal(v, x)
    return changements


# Avancement du lot, affiché par le monitor (vue Graph, nœud du cycle) : une carte est faite par le dev quand run-lot.sh
# l'a passée en Waiting for review (sa passe est poussée dans la PR du lot), ou plus loin (Under review, Finished). Une
# carte renvoyée en Work in progress au verdict repasse dans le reste à faire ; annulée, archivée ou fermée, elle sort
# du total.
LISTES_FAITES = ("waiting", "review", "finished")
LISTES_HORS_LOT = ("canceled", "archived")
ORDRE_LISTES = ("not_ready", "standby", "wip", "blocked", "waiting", "review", "finished")


def lire_tableau_leger():
    """Cartes ouvertes du tableau (id, titre, liste), en une seule lecture et sans nouvel essai : le relais la refait au
    passage suivant. Les titres servent à suivre les cartes reportées (~160 ko pour ~800 cartes, 0,5 s)."""
    return trello("GET", f"/boards/{TRELLO_BOARD}/cards/open", _essais=1, _delai=20, fields="name,idList")


def avancement(etat, sur_tableau):
    """Compte des cartes du lot faites par le dev, d'après la liste Trello de chacune."""
    detail = {str(c["num"]): (LISTE_DE_ID.get(sur_tableau[c["id"]], "?") if c["id"] in sur_tableau else "archived")
              for c in etat["cartes"]}
    dans_lot = [k for k in detail.values() if k not in LISTES_HORS_LOT]
    par_liste = {}
    for k in ORDRE_LISTES + ("?",):
        n = dans_lot.count(k)
        if n:
            par_liste[NOM_LISTE.get(k, k)] = n
    return {"heure": iso(), "faites": sum(1 for k in dans_lot if k in LISTES_FAITES), "total": len(dans_lot),
            "par_liste": par_liste, "cartes": detail}


def lire_tableau_pour_avancement(chemins):
    """Lecture du tableau pour l'avancement : une par passage du relais, hors verrou (quelques secondes pour ~800
    cartes), et seulement s'il y a un lot en cours. Rend None (rien à lire), le tableau, ou l'erreur."""
    for p in chemins:
        try:
            e = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if e.get("etape") != "livre" and e.get("cartes"):
            try:
                return lire_tableau_leger()
            except Exception as ex:  # noqa: BLE001
                return ex
    return None


def sans_cles(texte):
    """Message d'erreur sans les clés Trello : il est écrit dans l'état du lot, que le monitor affiche."""
    try:
        for x in trello_cles():
            texte = texte.replace(x, "***")
    except RuntimeError:
        pass
    return texte


def noter_avancement(etat, tableau):
    """Met à jour etat["avancement"] avec le tableau lu en début de passage. Une lecture ratée garde le dernier compte
    avec son heure et note l'erreur, sans entrer dans les erreurs du passage : l'avancement n'est qu'un affichage."""
    if tableau is None or not etat.get("cartes"):
        return
    if isinstance(tableau, Exception):
        av = dict(etat.get("avancement") or {})
        erreur = sans_cles(str(tableau))[:200]
        if not av.get("erreur"):
            journal(etat["version"], f"avancement : lecture de Trello impossible ({erreur})")
        av["erreur"] = erreur
        etat["avancement"] = av
    else:
        try:
            suivre_cartes(etat, tableau)
        except Exception as e:  # noqa: BLE001 — ne fait pas tomber le passage ; passe et verdict refont le suivi
            journal(etat["version"], f"cartes du lot : suivi impossible ({type(e).__name__} : {str(e)[:200]})")
        etat["avancement"] = avancement(etat, {c["id"]: c.get("idList") for c in tableau})


def ou_sont(etat):
    """Liste actuelle de chaque carte du lot : {num: clé de liste}, après avoir aligné les cartes du lot sur le tableau
    (une carte reportée en sort)."""
    toutes = cartes_du_tableau()
    suivre_cartes(etat, toutes)
    ici = {c["id"]: c["idList"] for c in toutes}
    return {c["num"]: LISTE_DE_ID.get(ici.get(c["id"]), "?") for c in etat["cartes"]}


def deplacer(etat, nums, liste, haut=False):
    par_num = {c["num"]: c for c in etat["cartes"]}
    faits, rates = [], []
    for n in sorted(nums):
        try:
            trello("PUT", f"/cards/{par_num[n]['id']}", idList=LISTES[liste], pos="top" if haut else "bottom")
            faits.append(n)
        except RuntimeError:
            rates.append(n)
    if faits:
        journal(etat["version"], f"Trello : cartes {', '.join(map(str, faits))} en {NOM_LISTE[liste]}")
    if rates:
        journal(etat["version"], f"Trello : ÉCHEC du déplacement en {NOM_LISTE[liste]} des cartes {', '.join(map(str, rates))}")
    return faits, rates


# ---------------------------------------------------------------- GitHub

def prs_ouvertes(base):
    res = []
    for depot, nom in DEPOTS.items():
        for p in gh_json("pr", "list", "-R", nom, "--base", base, "--state", "open", "--limit", "20",
                         "--json", "number,headRefName,headRefOid,labels,url,title"):
            res.append({"depot": depot, "num": p["number"], "branche": p["headRefName"], "sha": p["headRefOid"],
                        "url": p["url"], "titre": p["title"], "labels": [lb["name"] for lb in p["labels"]]})
    return res


def vue_pr(depot, num):
    return gh_json("pr", "view", str(num), "-R", DEPOTS[depot], "--json",
                   "number,state,headRefOid,headRefName,baseRefName,labels,mergeable,mergeCommit,url")


def runs(depot, **filtres):
    args = ["run", "list", "-R", DEPOTS[depot], "--workflow", WORKFLOW[depot], "--limit", "30",
            "--json", "databaseId,status,conclusion,event,headSha,headBranch,createdAt"]
    for k, v in filtres.items():
        args += [f"--{k}", v]
    return gh_json(*args)


def dernier_run(depot, sha, event, branche=None):
    rs = [r for r in runs(depot, commit=sha, event=event) if branche is None or r["headBranch"] == branche]
    return max(rs, key=lambda r: r["createdAt"]) if rs else None


def jobs_du_run(depot, run_id):
    return {j["name"]: j.get("conclusion") for j in gh_json("run", "view", str(run_id), "-R", DEPOTS[depot],
                                                             "--json", "jobs")["jobs"]}


def bilan_run(depot, run, requis=()):
    """('absent' | 'en cours' | 'vert' | 'rouge', résumé) d'un run, jobs requis compris (un job sauté n'a rien testé)."""
    if not run:
        return "absent", "aucun run"
    rid = run["databaseId"]
    if run["status"] != "completed":
        return "en cours", f"run {rid} {run['status']}"
    jobs = jobs_du_run(depot, rid)
    manquants = [n for n in requis if jobs.get(n) != "success"]
    if run["conclusion"] == "success" and not manquants:
        return "vert", f"run {rid} vert"
    rouges = [n for n, c in jobs.items() if c in ("failure", "cancelled", "timed_out")]
    sautes = [n for n in manquants if jobs.get(n) in ("skipped", None)]
    detail = f"run {rid} {run['conclusion']}"
    if rouges:
        detail += f", jobs rouges : {', '.join(rouges)}"
    if sautes:
        detail += f", jobs requis sautés ou absents : {', '.join(sautes)}"
    return "rouge", detail


def rouge_sans_rapport(depot, run):
    if run.get("conclusion") == "cancelled":
        return True
    rc, log = gh_cmd("run", "view", str(run["databaseId"]), "-R", DEPOTS[depot], "--log-failed", timeout=240)
    return bool(RE_NON_CODE.search(log))


def relancer_si_sans_rapport(etat, depot, run, deja):
    """Relance une fois les jobs rouges d'un run qui ne juge pas le code. True si relancé."""
    cle = str(run["databaseId"])
    if cle in deja or not rouge_sans_rapport(depot, run):
        return False
    rc, out = gh_cmd("run", "rerun", cle, "-R", DEPOTS[depot], "--failed")
    deja.append(cle)
    journal(etat["version"], f"run {cle} ({depot}) rouge sans rapport avec le code : relancé une fois ({'ok' if rc == 0 else out[-200:]})")
    return rc == 0


def ci_pr(pr, requis):
    if PAUSE in pr.get("labels", []):
        return "rouge", f"étiquette {PAUSE} encore posée : la CI n'a pas jugé ce code"
    return bilan_run(pr["depot"], dernier_run(pr["depot"], pr["sha"], "pull_request"), requis)


def tete(depot, branche):
    return gh_json("api", f"repos/{DEPOTS[depot]}/git/ref/heads/{branche}")["object"]["sha"]


def url_preview_front(sha):
    """URL de la preview du front pour ce commit, d'après les déploiements GitHub (Vercel, Netlify… les créent)."""
    if "front" not in DEPOTS:
        return None
    try:
        deps = gh_json("api", f"repos/{DEPOTS['front']}/deployments?sha={sha}&per_page=5")
        for d in deps or []:
            for s in gh_json("api", f"repos/{DEPOTS['front']}/deployments/{d['id']}/statuses") or []:
                if s.get("state") == "success" and s.get("environment_url"):
                    return s["environment_url"]
    except RuntimeError:
        pass
    return None


def lancer_deploiement_preview(etat, branche):
    """Back du lot sur la preview, par un workflow_dispatch de son workflow sur la branche du lot (le workflow doit
    déployer une branche lancée à la main sur l'environnement de preview). Une PR n'étant pas déployée, les tests
    Playwright du relecteur verraient sinon le front du lot avec l'ancien back."""
    t0 = maintenant() - dt.timedelta(minutes=1)
    depot = PREVIEW["depot"]
    rc, out = gh_cmd("workflow", "run", PREVIEW.get("workflow") or WORKFLOW[depot], "-R", DEPOTS[depot], "--ref", branche)
    dep = {"branche": branche, "lance": iso(), "run": None, "erreur": None if rc == 0 else out[-300:],
           "relances": [], "vert_a": None}
    if rc == 0:
        for _ in range(6):
            dep["run"] = trouver_run_dispatch(branche, t0)
            if dep["run"]:
                break
            time.sleep(5)
    journal(etat["version"], f"déploiement preview de {branche} : run {dep['run'] or '?'}{' ÉCHEC ' + dep['erreur'] if dep['erreur'] else ''}")
    return dep


def trouver_run_dispatch(branche, apres):
    try:
        rs = [r for r in runs(PREVIEW["depot"], branch=branche, event="workflow_dispatch") if date(r["createdAt"]) >= apres]
    except RuntimeError:
        return None
    return max(rs, key=lambda r: r["createdAt"])["databaseId"] if rs else None


