def version_suivante(version, toutes):
    def cle(s):
        return tuple(int(x) for x in s.split("."))
    vues = set()
    for c in toutes:
        m = RE_CARTE.match(c["name"])
        if m and c["idList"] not in (LISTES["canceled"], LISTES["archived"]):
            vues.add(m.group("ver"))
    plus = sorted((x for x in vues if cle(x) > cle(version)), key=cle)
    if plus:
        return plus[0]
    parts = version.split(".")
    parts[-1] = str(int(parts[-1]) + 1)
    return ".".join(parts)


