def main():
    ap = argparse.ArgumentParser(prog="cycle-lot", description=f"Cycle de lot : relais {N_DEV} <-> {N_REV} (README.md).")
    ap.add_argument("--par", choices=(DEV, REV, RELAIS), help="agent appelant (déduit du dossier courant sinon)")
    commun = argparse.ArgumentParser(add_help=False)
    commun.add_argument("--par", choices=(DEV, REV, RELAIS), default=argparse.SUPPRESS,
                        help="agent appelant (déduit du dossier courant sinon)")
    sp = ap.add_subparsers(dest="cmd", required=True)

    p = sp.add_parser("debut", help=f"{N_DEV}, sur demande de {HUMAIN} : crée le cycle du lot", parents=[commun])
    p.add_argument("version")
    p.add_argument("--session-key", required=True)
    p.add_argument("--dossier-lot")
    p.set_defaults(f=cmd_debut)

    p = sp.add_parser("passe", help=f"{N_DEV} : passe la main à {N_REV} (revue, ou validations en production)",
                      parents=[commun])
    p.add_argument("version")
