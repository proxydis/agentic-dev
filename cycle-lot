    p = sp.add_parser("reprise", help=f"reprend un cycle arrêté, après la réponse de {HUMAIN}", parents=[commun])
    p.add_argument("version")
    p.add_argument("--decision", required=True)
    p.add_argument("--etape")
    p.add_argument("--rallonge", action="store_true", help=f"un aller-retour de plus, autorisé par {HUMAIN}")
    p.set_defaults(f=cmd_reprise)

    p = sp.add_parser("intervention", help=f"interventions de {HUMAIN} demandées au démarrage", parents=[commun])
    p.add_argument("version")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--ajouter")
    g.add_argument("--faite", type=int)
    p.set_defaults(f=cmd_intervention)

    p = sp.add_parser("carte-bug", help=f"{N_REV} : carte de bug vu en production, version suivante, Not Ready",
                      parents=[commun])
    p.add_argument("version")
