    p.add_argument("--message")
    p.add_argument("--fichier")
    p.add_argument("--dossier-lot")
    p.set_defaults(f=cmd_passe)

    p = sp.add_parser("verdict", help=f"{N_REV} : verdict de revue", parents=[commun])
    p.add_argument("version")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--merger", action="store_true")
    g.add_argument("--a-reprendre", action="store_true")
    p.add_argument("--rapport", required=True)
    p.add_argument("--cartes-ok")
    p.add_argument("--cartes-ko")
    p.add_argument("--message")
    p.set_defaults(f=cmd_verdict)

    p = sp.add_parser("merge", help=f"{N_REV} : merge gardé d'une PR de l'étape", parents=[commun])
    p.add_argument("version")
    p.add_argument("--pr", required=True)
    p.set_defaults(f=cmd_merge)

    p = sp.add_parser("ouvrir-livraison", help=f"{N_DEV} : PR release -> develop et master", parents=[commun])
    p.add_argument("version")
    p.add_argument("--message")
    p.set_defaults(f=cmd_ouvrir_livraison)

    p = sp.add_parser("attendre-ci", help=f"{N_REV} : CI de livraison relancée, le relais attend le verdict",
                      parents=[commun])
    p.add_argument("version")
    p.add_argument("--message")
    p.set_defaults(f=cmd_attendre_ci)

    p = sp.add_parser("arret", help=f"arrête le cycle : décision de {HUMAIN} attendue", parents=[commun])
    p.add_argument("version")
    p.add_argument("--motif", required=True, choices=("arbitrage", "intervention", "aller-retours", "ci",
                                                     "deploiement", "autre"))
    p.add_argument("--message", required=True)
