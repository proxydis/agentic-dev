def ouvrir_prs_livraison(etat):
    """Les PR release/<v> -> develop et master de chaque dépôt en avance, créées ou rouvertes (le back n'écoute pas
    `synchronize` : rouvrir relance la CI sur la tête). Rend (prs, créées) ; lève Refus."""
    ouvertes = [i for i in etat["interventions"] if not i["faite"]]
    if ouvertes:
        raise Refus(f"interventions de {HUMAIN} encore ouvertes : " + "; ".join(f"{i['n']}. {i['texte']}" for i in ouvertes)
                    + f". Fais-les confirmer (`cycle-lot intervention {etat['version']} --faite N`) ou `cycle-lot arret "
                      f"{etat['version']} --motif intervention`.")
    v, rel = etat["version"], etat["release"]
    prs, creees = [], []
    for depot, nom in DEPOTS.items():
        for base in ("develop", "master"):
            ahead = gh_json("api", f"repos/{nom}/compare/{base}...{rel}", "--jq", ".ahead_by")
            if not ahead:
                continue
            exist = gh_json("pr", "list", "-R", nom, "--head", rel, "--base", base, "--state", "open", "--json", "number")
            if exist:
                n = exist[0]["number"]
                if base == "master":
                    gh_cmd("pr", "close", str(n), "-R", nom)
                    gh_cmd("pr", "reopen", str(n), "-R", nom)
            else:
                lot = ", ".join(f"#{x['num']}" for x in etat["prs_lot"] if x["depot"] == depot) or "-"
                corps = (f"Livraison du lot {v} : `{rel}` vers `{base}` ({depot}).\n\nPR du lot : {lot}. "
                         f"Cartes : {', '.join(str(c['num']) for c in etat['cartes'])}.\n"
                         f"Dernier rapport de revue de {N_REV} : "
                         f"{etat['rapports'][-1]['fichier'] if etat['rapports'] else '-'}.\n\n"
                         f"Cycle de lot : CI, contrôle du contenu (lot revu seulement) et merge par le relais ; revue de "
                         f"{N_REV} en cas d'écart.")
                rc, out = gh_cmd("pr", "create", "-R", nom, "--base", base, "--head", rel,
                                 "--title", f"release({v}): lot {v} vers {base} ({depot})", "--body", corps)
                if rc != 0:
                    raise Refus(f"création de la PR {depot} vers {base} refusée : {out[-300:]}")
                m = re.search(r"/pull/(\d+)", out)
                n = int(m.group(1)) if m else gh_json("pr", "list", "-R", nom, "--head", rel, "--base", base,
                                                      "--state", "open", "--json", "number")[0]["number"]
                creees.append(f"{depot}#{n}")
            vue = vue_pr(depot, n)
            prs.append({"depot": depot, "num": n, "base": base, "branche": rel, "sha": vue["headRefOid"],
                        "url": vue["url"], "labels": []})
    if not prs:
        raise Refus(f"{rel} n'a aucun commit d'avance sur develop ni master : rien à livrer")
    etat["prs_livraison"] = prs
    return prs, creees


