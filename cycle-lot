        corps = (f"\nTu as la main sur le développement du lot.{mot}\nSi ton lanceur run-lot tourne, rien à faire. "
                 f"Sinon reprends le lot là où il s'est arrêté ; quand la CI de fin de lot est verte : `cycle-lot passe "
                 f"{v} --vers {REV} --message \"<bilan du lot, arbitrages pris>\"`.")
    else:
        corps = mot
    return tete_msg + corps + (("\n" + extra) if extra else "") + pied(etat, agent)


def arreter(etat, par, motif, message, etape_reprise=None):
    etat["arret"] = {"motif": motif, "message": message, "par": par, "heure": iso(),
                     "etape": etape_reprise or etat["etape"],
                     "attente": None if etape_reprise else etat.get("attente")}
    changer_etape(etat, "arret", par, f"arrêt ({motif}) : {message}")
    # un message de l'humain sans mention ne réveille aucun agent (règle de groupe des agents) : nommer celui à mentionner
    qui = NOMS[par] if par in (DEV, REV) else N_DEV
    planifier_avis(etat, f"⛔ cycle arrêté ({motif}). {message} <@{HUMAIN_SLACK}> ta décision est attendue : réponds dans ce fil "
                 f"en mentionnant {qui}, qui relancera le cycle (`cycle-lot reprise`). Sans mention, aucun agent ne se "
                 f"réveille.")


# ---------------------------------------------------------------- commandes

def cmd_debut(a):
    agent = appelant(a)
    v = a.version
    if agent not in (DEV, RELAIS):
        raise Refus(f"seul {N_DEV} lance un lot, et seulement quand {HUMAIN} le lui demande")
    if not RE_VERSION.match(v):
        raise Refus(f"version « {v} » illisible (ex. 1.0.0 ou 1.2.3.4)")
    m = RE_SESSION.match(a.session_key.strip())
    if not m or m.group("agent") != DEV:
        raise Refus(f"--session-key : la clé de session de {N_DEV} dans le fil du lot (ligne Runtime, "
                    f"agent:{DEV}:slack:channel:…:thread:…)")
    with verrou(v, creer=True):
        if chemin_etat(v).exists():
            e = lire(v)
            raise Refus(f"un cycle existe déjà pour le lot {v} (étape « {e['etape']} ») : `cycle-lot etat {v}`")
        cartes = cartes_de_version(v)
        cartes = [c for c in cartes if c["liste"] != LISTES["finished"]]
        if not cartes:
            raise Refus(f"aucune carte [V{v}-…] ouverte sur le tableau Trello")
        nums = [c["num"] for c in cartes]
        doublons = sorted({n for n in nums if nums.count(n) > 1})
        if doublons:
            raise Refus(f"numéros de cartes en double dans le lot : {doublons}. {N_REV} classe les cartes par numéro : "
                        f"renumérote-les sur Trello, puis relance `cycle-lot debut`.")
        etat = {"version": v, "prefixe": v.replace(".", ""), "release": f"release/{v}",
                "fil": {"canal": m.group("canal").upper(), "ts": m.group("ts"), "cle_dev": a.session_key.strip()},
                "dossier_lot": a.dossier_lot, "cree": iso(), "etape": None, "tour": None, "depuis": None, "seq": 0,
                "aller_retours": 0, "max_aller_retours": MAX_ALLER_RETOURS, "ci_rouges": 0,
                "cartes": [{"id": c["id"], "num": c["num"], "nom": c["nom"], "url": c["url"]} for c in cartes],
                "prs_lot": [], "prs_livraison": [], "interventions": [], "rapports": [], "cartes_bugs": [],
                "attente": None, "arret": None, "relances": {}, "reveils": [], "a_reveiller": None, "avis_en_attente": [],
                "historique": [], "dernier_message": None, "liste_validation": None}
        changer_etape(etat, "dev", agent, f"cycle créé à la demande de {HUMAIN}")
        faits, rates = deplacer(etat, {c["num"] for c in cartes}, "wip")
        ecrire(etat)
    print(f"Cycle du lot {v} créé : étape « dev », main à {N_DEV}. Fil {etat['fil']['canal']} {etat['fil']['ts']}.")
    print(f"{len(cartes)} cartes du lot : {', '.join(str(c['num']) for c in cartes)} ; en Work in progress : "
          f"{', '.join(map(str, faits)) or 'aucune'}" + (f" ; ÉCHEC Trello pour {rates}" if rates else ""))
    print(f"Ensuite : arbitrages et interventions dès maintenant (règles a-d, `cycle-lot arret {v}` si bloquant), "
          f"puis run-lot impl ; à la CI verte, `cycle-lot passe {v} --vers {REV}`.")


def cmd_passe(a):
    agent = appelant(a)
    v = a.version
    avertissement = ""
    with verrou(v):
        etat = lire(v)
        if a.dossier_lot:
            etat["dossier_lot"] = a.dossier_lot
        if a.vers == REV and (a.etape or "revue") == "revue":
            exiger(etat, agent, ("dev", "correction"))
            prs = prs_ouvertes(etat["release"])
            if not prs:
                raise Refus(f"aucune PR ouverte vers {etat['release']} : rien à faire revoir")
            problemes = []
            for pr in prs:
                verdict, resume = ci_pr(pr, REQUIS_LOT[pr["depot"]])
                pr["ci"] = resume
                if verdict != "vert":
                    problemes.append(f"{pr['depot']} #{pr['num']} : {verdict}, {resume}")
            if problemes:
                raise Refus("la CI des PR du lot n'est pas verte. Étape 6 du cycle : corrige avant de demander la "
                            "revue (ou attends la fin de l'étape CI de run-lot).\n" + "\n".join(problemes))
            etat["prs_lot"] = prs
            ou = ou_sont(etat)
            a_revoir = {n for n, liste in ou.items() if liste in ("waiting", "wip")}
            encore_wip = sorted(n for n, liste in ou.items() if liste == "wip")
            deplacer(etat, a_revoir, "review")
            if encore_wip:
                avertissement = (f"Cartes encore en Work in progress au passage en revue (leur passe a-t-elle "
                                 f"abouti ?) : {', '.join(map(str, encore_wip))}.")
            a_deployer = [p for p in prs if PREVIEW and p["depot"] == PREVIEW["depot"]]
            msg = (a.message or "") + (f"\n{avertissement}" if avertissement else "")
            if a_deployer:
                dep = lancer_deploiement_preview(etat, a_deployer[0]["branche"])
                changer_etape(etat, "deploiement-revue", agent, msg, attente={"deploiement": dep})
                suite = (f"Le back du lot se déploie sur la preview (run {dep['run'] or '?'}) ; le relais réveille "
                         f"{N_REV} dès qu'il est en ligne.")
            else:
                changer_etape(etat, "revue", agent, msg)
                planifier_reveil(etat, REV, "revue", extra=extra_revue(etat, None))
                suite = f"Le relais réveille {N_REV} pour la revue dans les 2 minutes."
            ecrire(etat)
            print(f"Main passée à {N_REV} pour la revue du lot {v} (aller-retour {etat['aller_retours'] + 1}/"
                  f"{etat['max_aller_retours']}). PR : " + ", ".join(f"{p['depot']}#{p['num']}" for p in prs) + ". " + suite)
            if avertissement:
                print(avertissement)
        elif a.vers == REV and a.etape == "validation-prod":
            exiger(etat, agent, ("liste-validation",))
            if not a.fichier or not Path(a.fichier).is_file() or Path(a.fichier).stat().st_size == 0:
                raise Refus("--fichier : la liste des validations visuelles (fichier non vide)")
            etat["liste_validation"] = str(Path(a.fichier).resolve())
            changer_etape(etat, "validation-prod", agent, a.message or "")
            planifier_reveil(etat, REV, "validation-prod")
            ecrire(etat)
            print(f"Main passée à {N_REV} pour les validations en production : le relais le réveille dans les 2 minutes.")
        else:
            raise Refus(f"passe : `--vers {REV}` (revue, après le dev ou une correction) ou `--vers {REV} --etape "
                        "validation-prod --fichier <liste>`. Les autres passages de main sont faits par verdict, "
                        "merge, ouvrir-livraison et la veille.")


def extra_revue(etat, note):
    lignes = []
    front = [p for p in etat["prs_lot"] if p["depot"] == "front"]
    if front:
        url = url_preview_front(front[0]["sha"])
        lignes.append(f"Front du lot : preview de la PR, {url or 'URL dans les checks de la PR'}.")
    else:
        lignes.append(f"Pas de PR front : front de la release sur {URL_PREVIEW}.")
    dep = (etat.get("attente") or {}).get("deploiement")
    if dep:
        lignes.append(f"Back du lot : branche {dep['branche']} déployée sur la preview (run {dep.get('run') or '?'}). "
                      f"Vérifie que /health du back de preview a redémarré après ce run avant tes parcours.")
    else:
        lignes.append("Pas de PR back : le back de preview est celui de la release.")
    if note:
        lignes.append(note)
    return "\n".join(lignes)


def cmd_verdict(a):
    agent = appelant(a)
    v = a.version
    with verrou(v):
        etat = lire(v)
        exiger(etat, agent, ("revue", "revue-livraison"))
        rapport = Path(a.rapport).resolve() if a.rapport else None
        if not rapport or not rapport.is_file() or rapport.stat().st_size == 0:
            raise Refus("--rapport : ton rapport de revue (fichier non vide, points bloquants et non bloquants avec "
                        "fichier:ligne, cartes validées et refusées)")
        if a.merger and etat["etape"] == "revue-livraison":
            raise Refus("à l'étape revue-livraison, l'accord se traduit par le merge des PR : `cycle-lot merge`")
        ok, ko = liste_nums(a.cartes_ok), liste_nums(a.cartes_ko)
        if a.merger and ko:
            raise Refus("--merger avec des cartes refusées : c'est un verdict À REPRENDRE")
        ou = ou_sont(etat)  # avant le contrôle des numéros : une carte reportée n'est plus du lot
        connus = {c["num"] for c in etat["cartes"]}
        if (ok | ko) - connus:
            raise Refus(f"cartes inconnues du lot : {sorted((ok | ko) - connus)} (lot : {sorted(connus)})")
        if ok & ko:
            raise Refus(f"cartes à la fois validées et refusées : {sorted(ok & ko)}")
        en_revue = {n for n, liste in ou.items() if liste == "review"}
        etat["rapports"].append({"heure": iso(), "fichier": str(rapport), "verdict": "merger" if a.merger else "a-reprendre",
                                 "etape": etat["etape"], "aller_retour": etat["aller_retours"] + 1,
                                 "tetes": {f"{x['depot']}#{x['num']}": x["sha"] for x in etat["prs_lot"]}})
        if a.merger:
            restantes = {n for n, liste in ou.items() if liste in LISTES_EN_COURS}
            ailleurs = {n: liste for n, liste in ou.items() if liste not in LISTES_EN_COURS + ("finished",)}
            deplacer(etat, restantes, "finished", haut=True)
            laissees = ", ".join(f"{n} ({NOM_LISTE.get(liste, 'introuvable sur Trello')})" for n, liste in sorted(ailleurs.items()))
            if laissees:
                journal(v, f"verdict À MERGER : cartes laissées en place, hors revue : {laissees}")
            changer_etape(etat, "merge-lot", agent, a.message or "verdict À MERGER")
            # les merges gardés suivent le verdict dans la même commande ; un refus laisse la main au relecteur
            refus = []
            for x in sorted(etat["prs_lot"], key=lambda x: x["depot"] != "back"):
                try:
                    merger_pr(etat, etat["prs_lot"], x["depot"], x["num"], agent)
                except (Refus, RuntimeError) as e:
                    refus.append(f"{x['depot']}#{x['num']} : {e}")
                    break
            suite = apres_merges(etat, agent)
            ecrire(etat)
            print(f"Verdict À MERGER enregistré, cartes {sorted(restantes)} en Finished. {suite}"
                  + (f"\nCartes du lot laissées en place, hors revue : {laissees}. Signale-les dans ton bilan."
                     if laissees else "")
                  + (f"\nMerge refusé, {refus[0]}. Corrige, puis `cycle-lot merge {v} --pr <depot>#<n>` (back d'abord)."
                     if refus else ""))
            return
        if etat["etape"] == "revue":
            manquantes = en_revue - ok - ko
            if manquantes:
                raise Refus(f"classe chaque carte en Under review avec --cartes-ok ou --cartes-ko ; manquent : "
                            f"{sorted(manquantes)}")
        deplacer(etat, ok, "finished", haut=True)
        deplacer(etat, ko, "wip")
        etat["aller_retours"] += 1
        msg = a.message or f"À REPRENDRE, rapport {rapport}"
        if etat["aller_retours"] >= etat["max_aller_retours"]:
            arreter(etat, agent, "aller-retours",
                    f"{etat['aller_retours']}e verdict À REPRENDRE de {N_REV} (rapport {rapport}) : le cycle s'arrête "
                    f"au bout de {etat['max_aller_retours']} aller-retours. {N_DEV} ne lance pas de nouvelle correction.",
                    etape_reprise="correction")
            ecrire(etat)
            print("Verdict À REPRENDRE enregistré. C'est le dernier aller-retour permis : cycle ARRÊTÉ, décision de "
                  f"{HUMAIN} attendue. Poste ton rapport dans le fil.")
            return
        changer_etape(etat, "correction", agent, msg)
        planifier_reveil(etat, DEV, "correction")
        ecrire(etat)
        print(f"Verdict À REPRENDRE enregistré (aller-retour {etat['aller_retours']}/{etat['max_aller_retours']}). "
              f"Cartes validées : {sorted(ok) or 'aucune'} ; à reprendre : {sorted(ko) or 'aucune'}. "
              f"Le relais réveille {N_DEV} pour la correction dans les 2 minutes.")


def merger_pr(etat, ensemble, depot, num, par):
    """Merge gardé d'une PR de l'étape : tête inchangée depuis la revue, CI verte (jobs requis non sautés), pas de
    conflit, back avant front. Squash vers la release, commit de merge vers develop et master. Rend (pr, fait) ; lève
    Refus. Utilisé par le relecteur (`merge`, `verdict --merger`) et par le relais (PR de livraison)."""
    pr = next((x for x in ensemble if x["depot"] == depot and x["num"] == num), None)
    if not pr:
        raise Refus(f"{depot}#{num} ne fait pas partie des PR de l'étape : "
                    + ", ".join(f"{x['depot']}#{x['num']}" for x in ensemble))
    if pr.get("merge"):
        return pr, False
    if depot == "front" and any(x["depot"] == "back" and not x.get("merge") for x in ensemble):
        raise Refus("back d'abord : une release se livre dans l'ordre back, puis front (README du front)")
    vue = vue_pr(depot, num)
    if vue["state"] == "MERGED":
        pr["merge"] = {"heure": iso(), "commit": (vue.get("mergeCommit") or {}).get("oid", ""), "par": "hors relais"}
    else:
        if vue["state"] != "OPEN":
            raise Refus(f"{depot}#{num} est {vue['state']}")
        if vue["headRefOid"] != pr["sha"]:
            raise Refus(f"la tête de {depot}#{num} a bougé depuis la revue ({pr['sha'][:7]} -> "
                        f"{vue['headRefOid'][:7]}) : ce commit n'a pas été revu")
        labels = [lb["name"] for lb in vue.get("labels", [])]
        if PAUSE in labels:
            raise Refus(f"{depot}#{num} porte encore l'étiquette {PAUSE} : sa CI n'a rien jugé")
        if vue.get("mergeable") == "CONFLICTING":
            raise Refus(f"{depot}#{num} est en conflit avec {vue['baseRefName']}")
        base = vue["baseRefName"]
        if base.startswith("release/"):
            verdict, resume = ci_pr({**pr, "labels": labels}, REQUIS_LOT[depot])
        elif base == "master":
            verdict, resume = ci_pr({**pr, "labels": labels}, REQUIS_MASTER[depot])
        else:  # develop : aucune CI de PR (les workflows n'écoutent pas les PR vers develop)
            run = dernier_run(depot, pr["sha"], "pull_request")
            verdict, resume = ("vert", "pas de CI de PR vers develop") if not run else bilan_run(depot, run)
        if verdict != "vert":
            raise Refus(f"CI de {depot}#{num} : {verdict}, {resume}. Pas de merge sur une CI qui n'est pas verte.")
        methode = "--squash" if base.startswith("release/") else "--merge"
        rc, out = gh_cmd("pr", "merge", str(num), "-R", DEPOTS[depot], methode, "--match-head-commit", pr["sha"])
        if rc != 0:
            raise Refus(f"merge de {depot}#{num} refusé par GitHub : {out[-400:]}")
        vue = vue_pr(depot, num)
        pr["merge"] = {"heure": iso(), "commit": (vue.get("mergeCommit") or {}).get("oid", ""), "par": par}
    if "base" not in pr:  # PR du lot : son commit de merge est un commit revu (contrôle des PR de livraison)
        etat.setdefault("commits_revus", {}).setdefault(depot, []).append(pr["merge"]["commit"])
    journal(etat["version"], f"{depot}#{num} mergée ({pr['merge']['commit'][:7]}) par {pr['merge']['par']}")
    return pr, True


def apres_merges(etat, par):
    """Suite de l'étape une fois ses PR mergées : commit de release puis CI de la release, ou mise en production."""
    ensemble = etat["prs_lot"] if etat["etape"] == "merge-lot" else etat["prs_livraison"]
    reste = [f"{x['depot']}#{x['num']}" for x in ensemble if not x.get("merge")]
    if reste:
        return f"Reste à merger : {', '.join(reste)}."
    if etat["etape"] == "merge-lot":
        bascule = basculer_changelog(etat)
        depots = sorted({x["depot"] for x in ensemble})
        changer_etape(etat, "ci-release", par, f"PR du lot mergées dans {etat['release']}" + (f" ; {bascule}" if bascule else ""),
                      attente={"depots": depots, "relances": []})
        return (f"Toutes les PR du lot sont mergées{' ; ' + bascule if bascule else ''}. Le relais attend la CI du push "
                f"sur {etat['release']}, ouvre les PR de livraison et attend leur CI.")
    commits = [{"depot": x["depot"], "base": x["base"], "commit": x["merge"]["commit"]} for x in ensemble]
    changer_etape(etat, "deploiement", par, "PR de livraison mergées sur develop et master",
                  attente={"commits": commits, "relances": []})
    return ("Les PR de livraison sont mergées. Le relais attend la CI de develop et de master "
            f"(déploiement compris) puis réveille {N_DEV} pour la liste des validations.")


def gh_ecrire(chemin, methode, corps):
    """Appel d'écriture à l'API GitHub, corps JSON sur l'entrée standard (un CHANGELOG ne tient pas dans un argument)."""
    try:
        r = subprocess.run([GH, "api", "-X", methode, chemin, "--input", "-"], input=json.dumps(corps),
                           capture_output=True, text=True, timeout=120)
    except (subprocess.TimeoutExpired, OSError) as e:
        raise RuntimeError(f"gh api {methode} {chemin} : {e}")
    if r.returncode != 0:
        raise RuntimeError(f"gh api {methode} {chemin} : {(r.stderr or r.stdout).strip()[-300:]}")
    return json.loads(r.stdout or "{}")


def bascule_texte(texte, v, date_v):
    """CHANGELOG.md avec « ## [v] - date » ouvrant ce qui était sous « ## [Unreleased] » ; None s'il n'y a rien à faire
    (version déjà présente, pas de section [Unreleased], ou section vide)."""
    lignes = texte.split("\n")
    if any(re.match(rf"^## \[{re.escape(v)}\]", l) for l in lignes):
        return None
    i = next((k for k, l in enumerate(lignes) if l.strip().startswith("## [Unreleased]")), None)
    if i is None:
        return None
    j = i + 1
    while j < len(lignes) and not lignes[j].strip():
        j += 1
    fin = next((k for k in range(j, len(lignes)) if lignes[k].startswith("## [")), len(lignes))
    if not any(l.strip() for l in lignes[j:fin]):
        return None
    return "\n".join(lignes[:i + 1] + ["", f"## [{v}] - {date_v}", ""] + lignes[j:])


def lire_fichier_gh(nom, chemin, ref, essais=3):
    """Texte d'un fichier du dépôt à cette ref. Au-delà de 1 Mo, l'API contents ne sert pas le contenu (`encoding`
    « none », `content` vide) : on le lit alors par l'API des blobs (jusqu'à 100 Mo). Un CHANGELOG tenu depuis
    longtemps dépasse vite cette taille. Lève RuntimeError (404 compris)."""
    d = gh_json("api", f"repos/{nom}/contents/{chemin}?ref={ref}", essais=essais)
    if d.get("encoding") != "base64" or (not d.get("content") and d.get("size")):
        d = gh_json("api", f"repos/{nom}/git/blobs/{d['sha']}", essais=essais)
    return base64.b64decode(d.get("content") or "").decode("utf-8")


def basculer_changelog(etat):
    """Commit de release mécanique sur release/<v> (« docs(changelog): basculer [Unreleased] dans [v] - date ») :
    la section [v] ouvre ce qui était sous [Unreleased], et la version de package.json
    suit pour une version X.Y.Z. Un seul commit par dépôt, par l'API Git de GitHub (pas de clone). Idempotent. Une erreur
    est notée sans arrêter le cycle : la release diffère alors du lot revu et la revue de livraison du relecteur la verra.
    Rend un résumé, vide si rien n'a été fait."""
    v, rel = etat["version"], etat["release"]
    date_v = maintenant().strftime("%Y-%m-%d")
    faits = []
    for depot in sorted({x["depot"] for x in etat["prs_lot"]}):
        nom = DEPOTS[depot]
        try:
            fichiers = {}
            neuf = bascule_texte(lire_fichier_gh(nom, "CHANGELOG.md", rel), v, date_v)
            if neuf is not None:
                fichiers["CHANGELOG.md"] = neuf
                if re.fullmatch(r"\d+\.\d+\.\d+", v):
                    try:
                        t = lire_fichier_gh(nom, "package.json", rel, essais=1)
                    except RuntimeError:
                        t = None  # pas de package.json dans ce dépôt
                    if t:
                        t2 = re.sub(r'^(\s*"version"\s*:\s*")[^"]*(")', rf"\g<1>{v}\g<2>", t, count=1, flags=re.M)
                        if t2 != t:
                            fichiers["package.json"] = t2
            if not fichiers:
                continue
            tete_sha = gh_json("api", f"repos/{nom}/git/ref/heads/{rel}")["object"]["sha"]
            arbre = gh_json("api", f"repos/{nom}/git/commits/{tete_sha}")["tree"]["sha"]
            entrees = [{"path": chemin, "mode": "100644", "type": "blob",
                        "sha": gh_ecrire(f"repos/{nom}/git/blobs", "POST", {"content": t, "encoding": "utf-8"})["sha"]}
                       for chemin, t in fichiers.items()]
            nouvel_arbre = gh_ecrire(f"repos/{nom}/git/trees", "POST", {"base_tree": arbre, "tree": entrees})["sha"]
            commit = gh_ecrire(f"repos/{nom}/git/commits", "POST",
                               {"message": f"docs(changelog): basculer [Unreleased] dans [{v}] - {date_v}",
                                "tree": nouvel_arbre, "parents": [tete_sha]})["sha"]
            gh_ecrire(f"repos/{nom}/git/refs/heads/{rel}", "PATCH", {"sha": commit, "force": False})
            etat.setdefault("bascule", {}).setdefault(depot, []).append(commit)
            faits.append(f"{depot} {commit[:7]} ({', '.join(fichiers)})")
            journal(etat["version"], f"commit de release {depot} {commit[:7]} sur {rel} : {', '.join(fichiers)}")
        except (RuntimeError, KeyError, ValueError, TypeError) as e:
            journal(etat["version"], f"commit de release {depot} : ÉCHEC {str(e)[:200]}")
            faits.append(f"{depot} : commit de release impossible ({str(e)[:120]})")
    return ("commit de release " + ", ".join(faits)) if faits else ""


def controle_livraison(etat):
    """Les PR de livraison n'apportent que le lot revu si, sur chaque dépôt, les commits de la release absents de develop
    sont tous des merges de PR du lot revues par le relecteur, ou le commit de release du relais. Rend (ok, détail)."""
    revus, bascule = etat.get("commits_revus") or {}, etat.get("bascule") or {}
    for depot in sorted({x["depot"] for x in etat["prs_livraison"]}):
        cmp = gh_json("api", f"repos/{DEPOTS[depot]}/compare/develop...{etat['release']}")
        shas = [c.get("sha", "") for c in (cmp or {}).get("commits", [])]
        attendus = set(revus.get(depot, [])) | set(bascule.get(depot, []))
        intrus = [x[:7] for x in shas if x not in attendus]
        if intrus:
            return False, (f"{depot} : {len(intrus)} commit(s) de {etat['release']} absents de develop et hors du lot revu "
                           f"({', '.join(intrus[:6])}) : revue de livraison nécessaire")
    return True, "contenu des PR de livraison = lot revu (et commits déjà sur develop)"


