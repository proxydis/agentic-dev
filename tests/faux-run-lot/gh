#!/usr/bin/env python3
"""Faux `gh` pour l'essai de run-lot.sh : les PR ouvertes par le faux claude, leurs étiquettes, et un run vert par
PR rouverte en fin de lot. Le dépôt est celui du dossier courant (run-lot.sh lance gh depuis chaque dépôt)."""
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys

a = sys.argv[1:]
chemin = os.environ["GH_ETAT"]
# les deux voies appellent gh en même temps : état lu et réécrit sous verrou, jusqu'à la sortie
verrou = open(chemin + ".verrou", "w")
fcntl.flock(verrou, fcntl.LOCK_EX)
etat = json.load(open(chemin)) if os.path.exists(chemin) else {"prs": [], "runs": [], "appels": []}
etat["appels"].append(a)
depot = os.path.basename(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip())


def opt(nom):
    return a[a.index(nom) + 1] if nom in a else None


def pr(num):
    return next(p for p in etat["prs"] if p["depot"] == depot and p["num"] == int(num))


def tete(branche):
    sortie = subprocess.run(["git", "ls-remote", "origin", f"refs/heads/{branche}"], capture_output=True, text=True).stdout
    return sortie.split()[0] if sortie else ""


sortie = ""
if a[:2] == ["pr", "list"]:
    p = [x for x in etat["prs"] if x["depot"] == depot and x["branche"] == opt("--head") and x["base"] == opt("--base")
         and not x.get("ferme")]
    sortie = str(p[0]["num"]) if p else ""
elif a[:2] == ["pr", "edit"]:
    p = pr(a[2])
    if opt("--add-label"):
        p["labels"] = sorted(set(p["labels"]) | {opt("--add-label")})
    if opt("--remove-label"):
        p["labels"] = [x for x in p["labels"] if x != opt("--remove-label")]
elif a[:2] == ["pr", "close"]:
    pr(a[2])["ferme"] = True
elif a[:2] == ["pr", "reopen"]:
    p = pr(a[2])
    p["ferme"] = False
    if "ci-en-pause" not in p["labels"]:  # la CI ne part que sans l'étiquette
        etat["runs"].append({"depot": depot, "id": 100 + len(etat["runs"]), "sha": tete(p["branche"]),
                             "cree": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")})
elif a[:2] == ["pr", "view"]:
    p = pr(a[2])
    sortie = tete(p["branche"]) if opt("--json") == "headRefOid" else "MERGEABLE"
elif a[:2] == ["run", "list"]:
    if "first" in (opt("--jq") or ""):  # attente du verdict en fin de lot
        r = [x for x in etat["runs"] if x["depot"] == depot]
        sortie = f"{r[-1]['id']} completed success" if r else "null null null"
elif a[:2] in (["run", "cancel"], ["run", "rerun"], ["run", "view"]):
    pass
else:
    print("faux gh : commande inconnue " + " ".join(a), file=sys.stderr)
    sys.exit(1)
json.dump(etat, open(chemin + ".tmp", "w"), indent=1)
os.replace(chemin + ".tmp", chemin)
if sortie:
    print(sortie)
