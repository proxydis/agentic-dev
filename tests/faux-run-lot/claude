#!/usr/bin/env python3
"""Faux `claude --print` pour l'essai de run-lot.sh : lit le prompt sur stdin et fait ce que l'étape demande.

« ajoute le fichier X » : crée X, commite, pousse la branche courante et ouvre la PR du lot (dans l'état du faux gh)
la première fois. « écris tes questions » : écrit questions-arbitrage.md à l'endroit que le cadre de la passe PRE
indique. Écrit aussi la note de passation demandée par le cadre des voies."""
import json
import os
import re
import subprocess
import sys

prompt = sys.stdin.read()
etat_gh = os.environ["GH_ETAT"]


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout.strip()


m = re.search(r"ajoute le fichier (\S+)\.", prompt)
if m:
    nom = m.group(1)
    with open(nom, "w") as f:
        f.write(f"{nom}\n")
    git("add", nom)
    git("-c", "user.name=essai", "-c", "user.email=essai@example.test", "commit", "-qm", f"ajoute {nom}")
    branche = git("rev-parse", "--abbrev-ref", "HEAD")
    git("push", "-q", "origin", branche)
    depot = os.path.basename(git("rev-parse", "--show-toplevel"))
    base = re.search(r"Base : (\S+?)\.(?:\s|$)", prompt).group(1)
    etat = json.load(open(etat_gh)) if os.path.exists(etat_gh) else {"prs": [], "runs": [], "appels": []}
    if not any(p["depot"] == depot and p["branche"] == branche for p in etat["prs"]):
        etat["prs"].append({"depot": depot, "num": len(etat["prs"]) + 1, "branche": branche, "base": base, "labels": []})
    json.dump(etat, open(etat_gh, "w"), indent=1)

m = re.search(r"dans `([^`]*questions-arbitrage\.md)`", prompt)
if m and "écris tes questions" in prompt:
    with open(m.group(1), "w") as f:
        f.write("1. Seuil de l'alerte : 5 ou 10 ? Recommandation : 5.\n")

m = re.search(r"note de passation courte .*? dans `([^`]+)`", prompt, re.S)
if m:
    with open(m.group(1), "w") as f:
        f.write("fait, rien à signaler\n")
print("passe terminée")
